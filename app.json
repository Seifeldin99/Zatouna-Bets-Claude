{
  "expo": {
    "name": "Zatouna",
    "slug": "zatouna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zatouna",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zatouna.app"
    },
    "android": {
      "package": "com.zatouna.app",
      "adaptiveIcon": {
        "backgroundColor": "#202022",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c0ab21d5-4d38-4270-af0c-5f67fcd2970e"
      }
    },
    "owner": "seifeldin99s-team"
  }
}
